# Required for the AI Tour Planner (/tour-planner) — server-side only, never exposed to the browser.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required for the News/Blog section (/news) — server-side only, never exposed to the browser.
# Create an internal integration at https://www.notion.so/my-integrations to get a token,
# then share your news database with that integration.
NOTION_TOKEN=

# The Notion database ID for the news/blog posts (the 32-character ID in the database URL).
# Expected database columns: Title (title), Date (date), Published (checkbox),
# an image/file property (files) or a page cover image, and optionally a
# "Locale" select property (ka/en/ru) to scope posts to a specific language.
NOTION_DATABASE_ID=

# Required for the /menu ordering page and the /rtveli booking form — server-side only, never
# exposed to the browser. Create a bot via https://t.me/BotFather to get a token. Orders/bookings
# are sent to the fixed chat ID configured in src/lib/constants.ts (TELEGRAM_ORDER_CHAT_ID).
TELEGRAM_BOT_TOKEN=

# The Notion database ID for Rtveli seasonal date availability (used by /rtveli).
# Share this database with the same Notion integration used for NOTION_TOKEN above.
# Expected database columns: Date (date), Vehicle (text), Total Seats (number),
# Booked Seats (number), Active (checkbox).
NOTION_RTVELI_DATABASE_ID=

# IndexNow (Bing/Yandex instant indexing). INDEXNOW_KEY is a 32-char hex key served at
# /{key}.txt; INDEXNOW_SECRET protects POST /api/indexnow (header: x-indexnow-secret).
# On production Vercel builds, scripts/indexnow-submit.mjs submits the sitemap URLs.
INDEXNOW_KEY=
INDEXNOW_SECRET=

# ── Direct booking (/book) ────────────────────────────────────────────────────────────
# Notion database "Akutsa Bookings" (defaults to the production database when unset).
NOTION_BOOKINGS_DATABASE_ID=

# Booking.com and Airbnb calendar export (iCal) URLs per unit. Dates in these feeds are
# blocked on the site. A missing variable just skips that source.
ICAL_LEMON_BOOKING=
ICAL_LEMON_AIRBNB=
ICAL_STRAWBERRY_BOOKING=
ICAL_STRAWBERRY_AIRBNB=
ICAL_BLUEBERRY_BOOKING=
ICAL_BLUEBERRY_AIRBNB=
ICAL_FIG_BOOKING=
ICAL_FIG_AIRBNB=
ICAL_COTTAGE_BOOKING=
ICAL_COTTAGE_AIRBNB=
ICAL_CAMPER_BOOKING=
ICAL_CAMPER_AIRBNB=

# Token for our own calendar export: /api/ical/<unit>.ics?t=<token> (imported into the OTAs).
ICAL_EXPORT_TOKEN=

# Secret Telegram sends with every webhook call to /api/telegram/booking
# (set as secret_token in setWebhook). Booking requests go to the same owner chat as
# menu orders (TELEGRAM_ORDER_CHAT_ID in src/lib/constants.ts); override with
# TELEGRAM_OWNER_CHAT_ID if needed.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
